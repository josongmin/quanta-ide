{
  "name": "@quanta/shell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*",
      "default": "./src/*"
    }
  },
  "scripts": {
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@quanta/canvas-engine": "workspace:*",
    "@quanta/shell-contract": "workspace:*",
    "@quanta/ui-kit": "workspace:*",
    "boring-avatars": "^2.0.4",
    "lucide-react": "^1.8.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.10.1"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": {
      "optional": true
    }
  }
}
