{
  "name": "quanta-ide",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "NODE_OPTIONS='--max-old-space-size=3072' tsc -b && NODE_OPTIONS='--max-old-space-size=3072' vite build",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=3072' tsc -b",
    "test": "NODE_OPTIONS='--max-old-space-size=2048' vitest run",
    "test:watch": "vitest",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=4096' vitest run --coverage",
    "validate": "pnpm typecheck && pnpm lint && pnpm lint:css && pnpm test",
    "validate:full": "pnpm typecheck && pnpm lint && pnpm lint:css && pnpm test && pnpm build && pnpm test:coverage",
    "preview": "vite preview",
    "security:audit": "pnpm audit --audit-level=high",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:clippy": "cd src-tauri && cargo clippy --all-targets -- -D warnings",
    "tauri:fmt": "cd src-tauri && cargo fmt -- --check",
    "tauri:test": "cd src-tauri && cargo test",
    "tauri:validate": "pnpm tauri:fmt && pnpm tauri:clippy && pnpm tauri:test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-avatar": "^1.1.11",
    "@tauri-apps/api": "^2.10.1",
    "boring-avatars": "^2.0.4",
    "codemirror": "^6.0.2",
    "framer-motion": "^12.38.0",
    "i18next": "^26.0.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.9",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-declaration-strict-value": "^1.10.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  }
}
