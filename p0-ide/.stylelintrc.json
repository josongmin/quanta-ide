{
  "extends": ["stylelint-config-standard"],
  "plugins": ["stylelint-declaration-strict-value"],
  "rules": {
    "scale-unlimited/declaration-strict-value": [
      [
        "/color$/",
        "fill",
        "stroke",
        "background-color",
        "border-color",
        "box-shadow",
        "font-family",
        "font-size",
        "font-weight",
        "line-height",
        "border-radius",
        "z-index",
        "transition",
        "transition-duration",
        "animation-duration"
      ],
      {
        "ignoreValues": [
          "currentColor",
          "transparent",
          "inherit",
          "initial",
          "unset",
          "none",
          "auto",
          "0",
          "normal",
          "/^var\\(/",
          "/^color-mix\\(/",
          "/^calc\\(/"
        ],
        "severity": "error",
        "message": "Use design tokens (var(--*)) instead of hardcoded values for '${property}'"
      }
    ],
    "declaration-property-value-disallowed-list": [
      {
        "/^padding/": ["/^\\d/"],
        "/^margin/": ["/^\\d/"],
        "gap": ["/^\\d/"]
      },
      {
        "severity": "error",
        "message": "Use spacing tokens (var(--space-*)) instead of raw values for '${property}'"
      }
    ],
    "color-named": "never",
    "function-disallowed-list": null,
    "selector-class-pattern": null,
    "custom-property-pattern": null,
    "keyframes-name-pattern": null,
    "declaration-block-no-redundant-longhand-properties": null,
    "no-descending-specificity": null,
    "alpha-value-notation": null,
    "color-function-notation": null,
    "hue-degree-notation": null,
    "shorthand-property-no-redundant-values": null,
    "media-feature-range-notation": null,
    "color-hex-length": null,
    "rule-empty-line-before": null,
    "comment-empty-line-before": null,
    "declaration-empty-line-before": null,
    "at-rule-empty-line-before": null,
    "property-no-vendor-prefix": null,
    "value-no-vendor-prefix": null,
    "selector-no-vendor-prefix": null,
    "at-rule-no-vendor-prefix": null,
    "length-zero-no-unit": null,
    "number-max-precision": null,
    "declaration-block-no-shorthand-property-overrides": null,
    "font-family-name-quotes": null,
    "font-family-no-missing-generic-family-keyword": null,
    "no-duplicate-selectors": null,
    "declaration-block-single-line-max-declarations": null,
    "no-invalid-double-slash-comments": null,
    "comment-whitespace-inside": null,
    "selector-pseudo-element-colon-notation": null,
    "selector-attribute-quotes": null,
    "function-url-quotes": null,
    "import-notation": null,
    "keyframe-selector-notation": null,
    "media-query-no-invalid": null,
    "no-unknown-animations": null,
    "value-keyword-case": null,
    "block-no-empty": null
  },
  "ignoreFiles": [
    "node_modules/**",
    "dist/**",
    "build/**",
    "src/shared/styles/tokens/**",
    "src/shared/styles/ide-base.css",
    "src/shared/styles/ide-layout.css",
    "src/shared/styles/ide-components.css",
    "src/shared/styles/ide-themes.css",
    "src/shared/styles/aurora.css",
    "src/shared/styles/overlay-tokens.css",
    "src/shared/styles/base.css"
  ],
  "overrides": [
    {
      "files": ["src/shared/styles/tokens/**"],
      "rules": {
        "scale-unlimited/declaration-strict-value": null,
        "declaration-property-value-disallowed-list": null
      }
    }
  ]
}
