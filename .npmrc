# Workspace-root pnpm config.
# Virtual store redirected out of the repo — matches the existing
# artifact-locations contract in .ai/AGENT.md. The Cargo target, Vite
# cache, and Playwright output all live under ~/.cache/quanta-ide/
# for the same reason: keep the working tree fast to index.
virtual-store-dir=${HOME}/.cache/quanta-ide/pnpm-virtual-store/root

# jest-dom 6.9.1 ships a `/vitest` subpath whose dist code does
# `import { expect } from 'vitest'` without declaring vitest as a peer
# dep. Under pnpm's strict virtual-store layout, that import fails with
# "Cannot find package 'vitest'" on every test file. Hoist vitest to
# the workspace root so Node's default resolution chain finds it
# regardless of which dep tries to import it.
public-hoist-pattern[]=vitest
public-hoist-pattern[]=@testing-library/jest-dom
public-hoist-pattern[]=@testing-library/react
public-hoist-pattern[]=jest-axe
public-hoist-pattern[]=@types/*
# Root eslint.config.js loads these directly, so they must appear in the
# workspace-root node_modules. p0-ide-v2's own eslint.config.js still works
# either way (its deps resolve from p0-ide-v2/node_modules first).
public-hoist-pattern[]=eslint
public-hoist-pattern[]=@eslint/*
public-hoist-pattern[]=typescript-eslint
public-hoist-pattern[]=eslint-plugin-*

# Monorepo linker is `isolated` by default (one node_modules per package,
# symlinked to virtual store). Keeps strict peer-dep behavior which is
# what catches mis-declared peers early — do NOT switch to `hoisted`
# unless a specific incompatibility forces it.
