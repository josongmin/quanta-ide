{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "@testing-library/jest-dom", "vite/client"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@quanta/domain-types": ["../libs/domain-types/src"],
      "@quanta/domain-types/*": ["../libs/domain-types/src/*"],
      "@quanta/shell-contract": ["../libs/shell-contract/src"],
      "@quanta/shell-contract/*": ["../libs/shell-contract/src/*"],
      "@quanta/shell": ["../libs/shell/src"],
      "@quanta/shell/*": ["../libs/shell/src/*"],
      "@quanta/ui-kit": ["../libs/ui-kit/src"],
      "@quanta/ui-kit/*": ["../libs/ui-kit/src/*"],
      "@quanta/canvas-engine": ["../libs/canvas-engine/src"],
      "@quanta/canvas-engine/*": ["../libs/canvas-engine/src/*"],
      "@quanta/canvas-worker": ["../libs/canvas-worker/src"],
      "@quanta/canvas-worker/*": ["../libs/canvas-worker/src/*"],
      "@quanta/canvas-pixi": ["../libs/canvas-pixi/src"],
      "@quanta/canvas-pixi/*": ["../libs/canvas-pixi/src/*"],
      "@quanta/code-universe": ["../products/code-universe/src"],
      "@quanta/code-universe/*": ["../products/code-universe/src/*"],
      "@quanta/app-ide": ["packages/app-ide/src"],
      "@quanta/app-ide/*": ["packages/app-ide/src/*"],
      "@quanta/app-agent": ["packages/app-agent/src"],
      "@quanta/app-agent/*": ["packages/app-agent/src/*"],
      "@quanta/app-pr": ["packages/app-pr/src"],
      "@quanta/app-pr/*": ["packages/app-pr/src/*"],
      "@quanta/app-reviews": ["packages/app-reviews/src"],
      "@quanta/app-reviews/*": ["packages/app-reviews/src/*"],
      "@quanta/app-rules": ["packages/app-rules/src"],
      "@quanta/app-rules/*": ["packages/app-rules/src/*"],
      "@quanta/app-scenario": ["packages/app-scenario/src"],
      "@quanta/app-scenario/*": ["packages/app-scenario/src/*"],
      "@quanta/app-settings": ["packages/app-settings/src"],
      "@quanta/app-settings/*": ["packages/app-settings/src/*"],
      "@quanta/app-dashboard": ["packages/app-dashboard/src"],
      "@quanta/app-dashboard/*": ["packages/app-dashboard/src/*"],
      "@quanta/app-home": ["packages/app-home/src"],
      "@quanta/app-home/*": ["packages/app-home/src/*"],
      "@quanta/app-policy": ["packages/app-policy/src"],
      "@quanta/app-policy/*": ["packages/app-policy/src/*"],
      "@quanta/app-demo": ["packages/app-demo/src"],
      "@quanta/app-demo/*": ["packages/app-demo/src/*"],
      "@quanta/app-code-city": ["packages/app-code-city/src"],
      "@quanta/app-code-city/*": ["packages/app-code-city/src/*"]
    }
  },
  "include": ["src", "packages/*/src"]
}
