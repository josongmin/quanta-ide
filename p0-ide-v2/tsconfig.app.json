{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {

      "@quanta/shell-contract": ["packages/shell-contract/src"],
      "@quanta/shell-contract/*": ["packages/shell-contract/src/*"],
      "@quanta/shell": ["packages/shell/src"],
      "@quanta/shell/*": ["packages/shell/src/*"],
      "@quanta/app-ide": ["packages/app-ide/src"],
      "@quanta/app-ide/*": ["packages/app-ide/src/*"],
      "@quanta/app-agent": ["packages/app-agent/src"],
      "@quanta/app-agent/*": ["packages/app-agent/src/*"],
      "@quanta/app-pr": ["packages/app-pr/src"],
      "@quanta/app-pr/*": ["packages/app-pr/src/*"],
      "@quanta/app-reviews": ["packages/app-reviews/src"],
      "@quanta/app-reviews/*": ["packages/app-reviews/src/*"],
      "@quanta/app-rules": ["packages/app-rules/src"],
      "@quanta/app-rules/*": ["packages/app-rules/src/*"],
      "@quanta/app-scenario": ["packages/app-scenario/src"],
      "@quanta/app-scenario/*": ["packages/app-scenario/src/*"],
      "@quanta/app-settings": ["packages/app-settings/src"],
      "@quanta/app-settings/*": ["packages/app-settings/src/*"],
      "@quanta/app-home": ["packages/app-home/src"],
      "@quanta/app-home/*": ["packages/app-home/src/*"],
      "@quanta/ui-kit": ["packages/ui-kit/src"],
      "@quanta/ui-kit/*": ["packages/ui-kit/src/*"]
    }
  },
  "include": ["src", "packages/*/src"]
}
