virtual-store-dir=${HOME}/.cache/quanta-ide/pnpm-virtual-store/p0-ide-v2

# jest-dom 6.9.1 ships a `/vitest` subpath whose dist code does
# `import { expect } from 'vitest'` without declaring vitest as a peer
# dep. Under pnpm's strict virtual-store layout, that import fails with
# "Cannot find package 'vitest'" on every test file. Hoisting vitest to
# the workspace root keeps Node's default resolution chain finding it
# regardless of which dep tries to import it.
public-hoist-pattern[]=vitest
