# =============================================================================
# quanta-ide — root .gitignore
# =============================================================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# --- JS/TS / Vite build & bundles ---
dist/
dist-ssr/
build/
out/
.output/
.next/
.nuxt/
.svelte-kit/
storybook-static/
*.tsbuildinfo
.vite/
vite.config.*.timestamp-*

# --- Rust / Cargo (Tauri lives under p0-ide/src-tauri/) ---
**/target/
**/*.rs.bk
**/*.rlib
*.profraw
*.profdata

# --- Tauri codegen (re-generated on build) ---
p0-ide/src-tauri/gen/

# --- Environment & secrets (never commit) ---
.env
.env.*
!.env.example
!.env*.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
secrets/
.secrets/

# --- Logs & diagnostics ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Test & coverage ---
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
blob-report/
playwright/.cache/
**/__snapshots__/__diff_output__/

# --- Caches & tool output ---
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.prettiercache
.turbo/
.swc/
.ruff_cache/
.mypy_cache/
.hypothesis/
.tox/
.pytest_cache/
*.tmp
*.temp

# --- Python (demo-corpus / scripts) ---
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/
env/
ENV/

# --- OS junk ---
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Editors & IDEs ---
# Track only recommended extensions; keep personal settings local.
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.orig

# --- Local / machine-only overrides ---
*.local
.local/

# --- Deploy & SaaS CLI artifacts (regenerate locally) ---
.vercel/
.netlify/

# --- Optional: Yarn Berry (uncomment if you adopt PnP) ---
# .pnp.*
# .yarn/*
# !.yarn/patches
# !.yarn/plugins
# !.yarn/releases
# !.yarn/sdks
# !.yarn/versions
